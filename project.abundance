                {
                  "name": "topChamfer",
                  "ioValue": 1.2
                }
              ],
              "interpreterVersion": 1,
              "code": "/**\n * Chamfers the back (bottom) and front (top) perimeter edges of the case body.\n * Edges are picked by the XY plane they lie in, so vertical edges stay sharp.\n */\nfunction run(\n  shape: Assembly,\n  bottomZ: number = 0, // z of the back face, mm\n  bottomChamfer: number = 3, // 45 degree back chamfer, mm\n  topZ: number = 10, // z of the front face, mm\n  topChamfer: number = 1, // front edge chamfer, mm\n): Assembly {\n  return shape.onLeafs((leaf) => {\n    let solid = leaf.geometry;\n    solid = solid.chamfer(bottomChamfer, (e) => e.inPlane(\"XY\", bottomZ));\n    solid = solid.chamfer(topChamfer, (e) => e.inPlane(\"XY\", topZ));\n    leaf.geometry = solid;\n    return leaf;\n  }) as Assembly;\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Chamfers the back (bottom) and front (top) perimeter edges of the case body.\n * Edges are picked by the XY plane they lie in, so vertical edges stay sharp.\n */\nfunction run(shape, bottomZ = 0, // z of the back face, mm\nbottomChamfer = 3, // 45 degree back chamfer, mm\ntopZ = 10, // z of the front face, mm\ntopChamfer = 1) {\n    return shape.onLeafs((leaf) => {\n        let solid = leaf.geometry;\n        solid = solid.chamfer(bottomChamfer, (e) => e.inPlane(\"XY\", bottomZ));\n        solid = solid.chamfer(topChamfer, (e) => e.inPlane(\"XY\", topZ));\n        leaf.geometry = solid;\n        return leaf;\n    });\n}\n"
            }
          ],
