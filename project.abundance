            },
            {
              "atomType": "Extrude",
              "x": 0.4,
              "y": 0.3,
              "uniqueID": "id-844",
              "ioValues": [
                {
                  "name": "geometry",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
