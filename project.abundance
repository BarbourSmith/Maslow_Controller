              "uniqueID": "id-3206",
              "ioValues": [
                {
                  "name": "shape",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "bottomZ",
                  "ioValue": -8.9,
                  "currentEquation": "-(1.5 + BatterySpace + Wall)"
                },
                {
                  "name": "bottomChamfer",
                  "ioValue": 3
                },
